# Postgres connection string. Required - server/db.ts throws without it.
DATABASE_URL=postgres://user:password@localhost:5432/blog

# Required at startup: the agents construct their OpenAI clients eagerly.
OPENAI_API_KEY=sk-...

# Gates every admin and agent route. If unset, those routes return 503 rather
# than falling open. Use a long random value.
ADMIN_PASSWORD=

# Optional
PORT=5000
