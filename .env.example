# Postgres connection string (Neon serverless)
DATABASE_URL=postgres://user:password@host/dbname

# Required at startup - the agents build their OpenAI clients eagerly
OPENAI_API_KEY=sk-...

# Gates every admin and agent route. If unset, those routes refuse with 503
# rather than falling open. Use a long random value.
ADMIN_PASSWORD=

# Optional
PORT=5000
